{
  "name": "@firstdataunion/sentrook-openclaw",
  "version": "1.1.0-rc.1",
  "description": "OpenClaw plugin: Sentrook trajectory scanner for hosted scan.",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "author": "FirstDataUnion",
  "files": [
    "dist/",
    "index.ts",
    "sessionStore.ts",
    "sessionPolicy.ts",
    "slashCommand.ts",
    "pluginConfigPatch.ts",
    "operatorLog.ts",
    "planir.ts",
    "reviewCopy.ts",
    "policyCopy.ts",
    "auth.ts",
    "sanitize.ts",
    "approvalPolicy.ts",
    "scanErrorPolicy.ts",
    "localAllowlist.ts",
    "devLog.ts",
    "reviewCards.ts",
    "approvalGateway.ts",
    "dashboard.ts",
    "dashboardPage.ts",
    "dashboardPresent.ts",
    "allowlistCli.ts",
    "configure.ts",
    "scanEndpoint.ts",
    "cli.ts",
    "verify.ts",
    "openclaw.plugin.json",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FirstDataUnion/Sentrook.git",
    "directory": "integrations/openclaw/plugin"
  },
  "homepage": "https://github.com/FirstDataUnion/Sentrook/tree/main/integrations/openclaw/plugin",
  "bugs": {
    "url": "https://github.com/FirstDataUnion/Sentrook/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --legal-comments=none",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test approvalPolicy.test.ts auth.test.ts sanitize.test.ts configure.test.ts verify.test.ts localAllowlist.test.ts allowlistCli.test.ts scanErrorPolicy.test.ts index.test.ts register.test.ts planir.test.ts reviewCopy.test.ts packCheck.test.ts devLog.test.ts sessionStore.test.ts operatorLog.test.ts sessionPolicy.test.ts slashCommand.test.ts pluginConfigPatch.test.ts reviewCards.test.ts approvalGateway.test.ts dashboard.test.ts dashboardPresent.test.ts",
    "pack:check": "npm run build && node --experimental-strip-types packCheck.ts",
    "preview:dashboard": "node --experimental-strip-types dashboardPreview.ts"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
