{
  "name": "@firstdataunion/sentrook-openclaw",
  "version": "1.0.2",
  "description": "OpenClaw plugin: Sentrook trajectory scanner for hosted scan.",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "author": "FirstDataUnion",
  "files": [
    "dist/",
    "index.ts",
    "planir.ts",
    "reviewCopy.ts",
    "auth.ts",
    "sanitize.ts",
    "approvalPolicy.ts",
    "scanErrorPolicy.ts",
    "localAllowlist.ts",
    "allowlistCli.ts",
    "configure.ts",
    "scanEndpoint.ts",
    "cli.ts",
    "verify.ts",
    "openclaw.plugin.json",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FirstDataUnion/Sentrook.git",
    "directory": "integrations/openclaw/plugin"
  },
  "homepage": "https://github.com/FirstDataUnion/Sentrook/tree/main/integrations/openclaw/plugin",
  "bugs": {
    "url": "https://github.com/FirstDataUnion/Sentrook/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --legal-comments=none",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test approvalPolicy.test.ts auth.test.ts sanitize.test.ts configure.test.ts verify.test.ts localAllowlist.test.ts allowlistCli.test.ts scanErrorPolicy.test.ts index.test.ts register.test.ts planir.test.ts reviewCopy.test.ts",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
