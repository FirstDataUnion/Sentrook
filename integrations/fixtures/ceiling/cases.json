{
  "_comment": "Verdict ceiling. Both plugins must give `verdict` for `response` under `lines`: the verdict from risk and the lines, lowered to `ceiling` when it is `review`, then raised to `enforced`. The scanner never sets both a ceiling and `enforced`; the order is fixed here anyway. A plugin that ignores the ceiling still blocks, which fails safe.",
  "cases": [
    {
      "name": "custom lines: a score between the owner's review and block lines with ceiling review is reviewed",
      "lines": {
        "review_at": 85,
        "block_at": 95
      },
      "response": {
        "response_version": "2.0",
        "status": "ok",
        "risk": 90,
        "enforced": null,
        "ceiling": "review"
      },
      "verdict": "review"
    },
    {
      "name": "custom lines: a score over the owner's block line is lowered to review",
      "lines": {
        "review_at": 60,
        "block_at": 88
      },
      "response": {
        "response_version": "2.0",
        "status": "ok",
        "risk": 90,
        "enforced": null,
        "ceiling": "review"
      },
      "verdict": "review"
    },
    {
