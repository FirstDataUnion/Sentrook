      "arguments": { "command": "set -e\n./scripts/run.sh" },
      "sent": true
    },
    {
      "case": "~ file grant on a ./ path in a command run from ~",
      "grant": { "kind": "file", "pattern": "~/notes/*", "scope": "persistent", "allows": ["read"] },
      "identity": null,
      "arguments": { "command": "cat ./notes/a.md", "workdir": "~" },
      "sent": true
    },
    {
      "case": "file grant on a ./ path in a command run from elsewhere",
      "workspace": "/home/alex",
      "grant": { "kind": "file", "pattern": "/home/alex/notes/*", "scope": "persistent", "allows": ["read"] },
      "identity": null,
      "arguments": { "command": "cat ./notes/a.md", "workdir": "/srv/app" },
      "sent": false
    },
    {
      "case": "full-path file grant on a ./ path from a workspace elsewhere",
      "workspace": "/srv/app",
      "grant": { "kind": "file", "pattern": "/home/alex/notes/*", "scope": "persistent", "allows": ["read"] },
      "identity": null,
      "arguments": { "path": "./notes/a.md" },
      "sent": false
    },
    {
      "case": "file grant on a ${HOME} path, which the scanner does not resolve",
      "grant": { "kind": "file", "pattern": "/home/alex/notes/*", "scope": "persistent", "allows": ["read"] },
      "identity": null,
      "arguments": { "command": "cat ${HOME}/notes/a.md" },
      "sent": false
    },
    {
      "case": "file grant on a bare relative path, which the scanner does not resolve",
