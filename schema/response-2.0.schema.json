{
  "$defs": {
    "ConfidenceTier": {
      "additionalProperties": true,
      "description": "How much to trust the other two tiers. Higher is better.",
      "properties": {
        "agreement": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreement"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "model_certainty": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Certainty"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier 2 result",
          "title": "Score"
        }
      },
      "title": "ConfidenceTier",
      "type": "object"
    },
    "ConsequenceTier": {
      "additionalProperties": true,
      "description": "The worst harm if the call runs. Higher is worse.",
      "properties": {
        "irreversibility": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irreversibility"
        },
        "reach": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reach"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier 2 result",
          "title": "Score"
        },
        "self_modification": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Self Modification"
        },
        "sensitivity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        }
      },
      "title": "ConsequenceTier",
      "type": "object"
    },
    "Enforce": {
      "description": "Minimum outcome a floor guarantees whatever the plugin's thresholds are.",
      "enum": [
        "block",
        "review"
      ],
      "title": "Enforce",
      "type": "string"
    },
    "EntityDisplay": {
      "additionalProperties": true,
      "properties": {
        "display": {
          "description": "Trimmed display string (host only, no query strings)",
          "title": "Display",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "display"
      ],
      "title": "EntityDisplay",
      "type": "object"
    },
    "FloorApplied": {
      "additionalProperties": true,
      "properties": {
        "enforce": {
          "anyOf": [
            {
              "$ref": "#/$defs/Enforce"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor": {
          "title": "Floor",
          "type": "string"
        },
        "min_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Min Risk",
          "type": "number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "floor",
        "min_risk"
      ],
      "title": "FloorApplied",
      "type": "object"
    },
    "GrantHint": {
      "additionalProperties": true,
      "description": "A grant the owner could set so that a call like this would usually not be reviewed next time (the next scan's\nmodel sees the grant too, so it is not a promise). Offered only on the owner's own turns, and only when the\nscanner, re-scoring this call with the grant applied (the same probe answers, no new model call), finds\nthe risk below the review line. Never for a known-bad entity, a look-alike, content the agent read, an\n`enforced` decision or a call with an independent strong signal.",
      "properties": {
        "allows": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a file grant: what the call does to the file",
          "title": "Allows"
        },
        "expires_in_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Expires In Days",
          "type": "integer"
        },
        "kind": {
          "description": "The grant kind, as `/sentrook grant` takes it",
          "enum": [
            "destination",
            "file",
            "provider"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "description": "The grant pattern: the entity's value as the scanner reads it (a path under the home directory written with `~/`), never a secret",
          "title": "Pattern",
          "type": "string"
        },
        "relieves": {
          "description": "The reason codes in `reasons` the grant would remove",
          "items": {
            "type": "string"
          },
          "title": "Relieves",
          "type": "array"
        },
        "risk": {
          "description": "This call's risk with the grant applied, 0-100",
          "maximum": 100,
          "minimum": 0,
          "title": "Risk",
          "type": "number"
        },
        "scope": {
          "const": "persistent",
          "default": "persistent",
          "title": "Scope",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The entity it covers (an `entities` key)",
          "title": "Subject"
        }
      },
      "required": [
        "kind",
        "pattern",
        "risk"
      ],
      "title": "GrantHint",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": true,
      "properties": {
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/ProbeMeta"
          },
          "title": "Probes",
          "type": "array"
        },
        "scanner_version": {
          "title": "Scanner Version",
          "type": "string"
        },
        "versions": {
          "additionalProperties": true,
          "description": "Scan-wide versions: convergence parameter set, probes_enabled, lists",
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "scanner_version"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ProbeMeta": {
      "additionalProperties": true,
      "description": "The single record of what produced each part of the result.",
      "properties": {
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "status": {
          "$ref": "#/$defs/ProbeStatus"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "step",
        "status"
      ],
      "title": "ProbeMeta",
      "type": "object"
    },
    "ProbeStatus": {
      "enum": [
        "ok",
        "timeout",
        "error",
        "skipped"
      ],
      "title": "ProbeStatus",
      "type": "string"
    },
    "Reason": {
      "additionalProperties": true,
      "description": "`code` is a stable `domain.detail` value from the reason registry; deployment-specific\nqualifiers (a tool alias, a step number) go in `detail` so codes stay finite and countable.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The reason in plain words for the review card, from a fixed list: a clause in lower case with no full stop, which may name the subject as its `{E1}` placeholder. Null for a reason that does not say why the call is risky (relief, gaps in what the scan could check, split model answers) and for a repeat of an earlier reason's text.",
          "title": "Text"
        }
      },
      "required": [
        "code"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ReliefApplied": {
      "additionalProperties": true,
      "description": "A grant (or the request-named destination rule, with `grant_ref` null) that lowered a score.",
      "properties": {
        "effect": {
          "description": "What was removed, e.g. distrust+untrusted_origin, sensitivity:read",
          "title": "Effect",
          "type": "string"
        },
        "grant_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grant Ref"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "effect"
      ],
      "title": "ReliefApplied",
      "type": "object"
    },
    "RiskTree": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceTier"
        },
        "consequence": {
          "$ref": "#/$defs/ConsequenceTier"
        },
        "suspicion": {
          "$ref": "#/$defs/SuspicionTier"
        }
      },
      "title": "RiskTree",
      "type": "object"
    },
    "ScanError": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScanError",
      "type": "object"
    },
    "ScanStatus": {
      "description": "`ok`: every enabled probe returned. `degraded`: a probe failed or coverage dropped, but a score\nwas computed. `error`: no usable score (preparation failed).",
      "enum": [
        "ok",
        "degraded",
        "error"
      ],
      "title": "ScanStatus",
      "type": "string"
    },
    "SelfEditSave": {
      "additionalProperties": true,
      "description": "What a self-edit's saved content adds, read by rule from the written text, and whether the save qualifies for\nlenient handling. Present only on a self-edit (trigger `system` with a `self_edit` block).",
      "properties": {
        "adds": {
          "description": "Sorted and de-duplicated: `command` runnable steps; `destination` a host, URL, mail address, recipient or remote a later run reaches or sends to; `permission` a step that changes permissions, tool allowlists, host or agent config, plugins, hooks, the scheduler, approval or safety settings, or privilege (not the write into the memory or skill store itself); `secret` a secret-like value or a redaction placeholder",
          "items": {
            "enum": [
              "command",
              "destination",
              "permission",
              "secret"
            ],
            "type": "string"
          },
          "title": "Adds",
          "type": "array"
        },
        "lenient": {
          "default": false,
          "description": "True only when `adds` is empty or only `command`, the self-edit judge answered and none of its directive-from-read-content, loosened-oversight and unsupported-owner-claim answers reached 0.7, and no floor applies. Says nothing about the verdict: a plugin consults it only when the risk is in its review band, for a background save nobody can be asked about",
          "title": "Lenient",
          "type": "boolean"
        }
      },
      "title": "SelfEditSave",
      "type": "object"
    },
    "SuspicionTier": {
      "additionalProperties": true,
      "description": "How much the call looks like it serves a goal the owner did not set. Higher is worse.",
      "properties": {
        "concealment": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concealment"
        },
        "distrust": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distrust"
        },
        "exposure": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This scan's new untrusted inputs carried agent-directed instructions",
          "title": "Exposure"
        },
        "misalignment": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misalignment"
        },
        "overreach": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The call acts on more than the request covers, judged against what the agent read",
          "title": "Overreach"
        },
        "request_origin": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Origin"
        },
        "retry_after_denial": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Denial"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier 2 result",
          "title": "Score"
        },
        "session_exposure": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Earlier in this session the agent read content carrying instructions aimed at it",
          "title": "Session Exposure"
        },
        "untrusted_origin": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Untrusted Origin"
        }
      },
      "title": "SuspicionTier",
      "type": "object"
    },
    "ToolDescription": {
      "additionalProperties": true,
      "description": "Templated from the Jev action category; the plugin substitutes `{E1}` placeholders.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "title": "ToolDescription",
      "type": "object"
    }
  },
  "$id": "https://sentrook.firstdataunion.org/schema/response-2.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Response 2.0: the risk tree Sentrook returns to the plugin. Generated from sentrook 2.0.0a1 models; do not edit by hand.",
  "properties": {
    "action_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Echoed back by the plugin in history; opaque to it",
      "title": "Action Fingerprint"
    },
    "approval_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The same action in every session of this deployment (its entities hashed with a salt derived from the scanner's key, not the session's): what a plugin keys an owner's remembered approval on; opaque to it and used for nothing else",
      "title": "Approval Fingerprint"
    },
    "ceiling": {
      "anyOf": [
        {
          "const": "review",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Highest outcome the plugin may reach from risk: it decides from risk and its lines, lowers that to the ceiling, then raises it to `enforced`. Set when the owner attends the chat and nothing independent points to an attack; never together with `enforced`. A plugin that ignores it still blocks.",
      "title": "Ceiling"
    },
    "enforced": {
      "anyOf": [
        {
          "$ref": "#/$defs/Enforce"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Strongest enforcement of any applied floor"
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityDisplay"
      },
      "title": "Entities",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScanError"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only when status is error"
    },
    "floors_applied": {
      "items": {
        "$ref": "#/$defs/FloorApplied"
      },
      "title": "Floors Applied",
      "type": "array"
    },
    "grant_hints": {
      "description": "Up to three grants, each of which alone would bring this call below the review line next time, lowest resulting risk first. Empty when none would, and on every call below the line.",
      "items": {
        "$ref": "#/$defs/GrantHint"
      },
      "title": "Grant Hints",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "reasons": {
      "description": "Ordered by contribution to the result",
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "relaxable": {
      "anyOf": [
        {
          "const": true,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True when the owner attends the chat, the scan is fully informed, nothing independent points to an attack and nothing is `enforced`: a block here comes from the score alone. A plugin may then turn such a block into a review it always asks about, only while the owner has snoozed reviews; it never allows it silently. Null otherwise; it never changes `risk`. A plugin that ignores it still blocks.",
      "title": "Relaxable"
    },
    "relief_applied": {
      "items": {
        "$ref": "#/$defs/ReliefApplied"
      },
      "title": "Relief Applied",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "response_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Response Version",
      "type": "string"
    },
    "risk": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "0–100; null only when status is error",
      "title": "Risk"
    },
    "self_edit": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelfEditSave"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only on a self-edit: what the saved content adds and whether the save qualifies for lenient handling; absent otherwise"
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "New signed state token",
      "title": "State"
    },
    "status": {
      "$ref": "#/$defs/ScanStatus",
      "default": "ok"
    },
    "tool_description": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolDescription"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tree": {
      "$ref": "#/$defs/RiskTree"
    }
  },
  "required": [
    "request_id",
    "metadata"
  ],
  "title": "Response",
  "type": "object"
}
